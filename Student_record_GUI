import tkinter as tk
from tkinter import ttk, messagebox
import json
import os

FILE_NAME = "students.json"


# -------------------- File Handling --------------------

def load_students():
    if os.path.exists(FILE_NAME):
        try:
            with open(FILE_NAME, "r") as file:
                return json.load(file)
        except:
            return []
    return []


def save_students():
    with open(FILE_NAME, "w") as file:
        json.dump(students, file, indent=4)


students = load_students()


# -------------------- Functions --------------------

def clear_fields():
    id_entry.delete(0, tk.END)
    name_entry.delete(0, tk.END)
    age_entry.delete(0, tk.END)
    course_entry.delete(0, tk.END)
    email_entry.delete(0, tk.END)
    phone_entry.delete(0, tk.END)
    marks_entry.delete(0, tk.END)

    id_entry.focus()


def calculate_grade(marks):
    if marks >= 90:
        return "A+"
    elif marks >= 80:
        return "A"
    elif marks >= 70:
        return "B"
    elif marks >= 60:
        return "C"
    elif marks >= 50:
        return "D"
    else:
        return "F"


def add_student():
    student_id = id_entry.get().strip()
    name = name_entry.get().strip()
    age = age_entry.get().strip()
    course = course_entry.get().strip()
    email = email_entry.get().strip()
    phone = phone_entry.get().strip()
    marks = marks_entry.get().strip()

    if not all([student_id, name, age, course, email, phone, marks]):
        messagebox.showwarning(
            "Missing Information",
            "Please fill all fields."
        )
        return

    # Check duplicate ID
    for student in students:
        if student["id"] == student_id:
            messagebox.showerror(
                "Error",
                "Student ID already exists!"
            )
            return

    try:
        marks = float(marks)

        if marks < 0 or marks > 100:
            messagebox.showerror(
                "Invalid Marks",
                "Marks must be between 0 and 100."
            )
            return

    except ValueError:
        messagebox.showerror(
            "Invalid Marks",
            "Please enter valid marks."
        )
        return

    student = {
        "id": student_id,
        "name": name,
        "age": age,
        "course": course,
        "email": email,
        "phone": phone,
        "marks": marks,
        "grade": calculate_grade(marks)
    }

    students.append(student)
    save_students()

    messagebox.showinfo(
        "Success",
        "Student added successfully!"
    )

    clear_fields()
    display_students()


def display_students():
    # Clear existing table
    for item in student_table.get_children():
        student_table.delete(item)

    # Insert students
    for student in students:
        student_table.insert(
            "",
            tk.END,
            values=(
                student["id"],
                student["name"],
                student["age"],
                student["course"],
                student["email"],
                student["phone"],
                student["marks"],
                student["grade"]
            )
        )


def search_student():
    search_id = search_entry.get().strip()

    if not search_id:
        messagebox.showwarning(
            "Search",
            "Please enter Student ID."
        )
        return

    for student in students:
        if student["id"] == search_id:

            # Display information in fields
            clear_fields()

            id_entry.insert(0, student["id"])
            name_entry.insert(0, student["name"])
            age_entry.insert(0, student["age"])
            course_entry.insert(0, student["course"])
            email_entry.insert(0, student["email"])
            phone_entry.insert(0, student["phone"])
            marks_entry.insert(0, student["marks"])

            messagebox.showinfo(
                "Student Found",
                f"Student {student['name']} found."
            )
            return

    messagebox.showerror(
        "Not Found",
        "Student not found."
    )


def delete_student():
    selected = student_table.selection()

    if not selected:
        messagebox.showwarning(
            "Delete",
            "Please select a student from the table."
        )
        return

    item = student_table.item(selected[0])
    student_id = item["values"][0]

    confirm = messagebox.askyesno(
        "Confirm Delete",
        "Are you sure you want to delete this student?"
    )

    if confirm:
        for student in students:
            if student["id"] == student_id:
                students.remove(student)
                break

        save_students()
        display_students()

        messagebox.showinfo(
            "Success",
            "Student deleted successfully!"
        )

        clear_fields()


def update_student():
    student_id = id_entry.get().strip()

    if not student_id:
        messagebox.showwarning(
            "Update",
            "Please enter Student ID."
        )
        return

    for student in students:

        if student["id"] == student_id:

            student["name"] = name_entry.get().strip()
            student["age"] = age_entry.get().strip()
            student["course"] = course_entry.get().strip()
            student["email"] = email_entry.get().strip()
            student["phone"] = phone_entry.get().strip()

            try:
                marks = float(marks_entry.get())

                if marks < 0 or marks > 100:
                    messagebox.showerror(
                        "Invalid Marks",
                        "Marks must be between 0 and 100."
                    )
                    return

                student["marks"] = marks
                student["grade"] = calculate_grade(marks)

            except ValueError:
                messagebox.showerror(
                    "Invalid Marks",
                    "Please enter valid marks."
                )
                return

            save_students()
            display_students()

            messagebox.showinfo(
                "Success",
                "Student record updated successfully!"
            )
            return

    messagebox.showerror(
        "Error",
        "Student ID not found."
    )


